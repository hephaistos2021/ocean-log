---
// Layout for blog posts
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	description: string;
	date: Date;
	tags?: string[];
	readingTime?: string;
	image?: string;
}

const { title, description, date, tags = [], readingTime, image } = Astro.props;

// Format date as YYYY-MM-DD
const formatDate = (date: Date) => {
	return date.toISOString().split("T")[0];
};
---

<BaseLayout title={title} description={description} image={image}>
    <article class="post">
        <!-- Back link -->
        <a href="/posts" class="back-link"> ← cd .. </a>

        <!-- Post header -->
        <header class="post-header">
            <h1 class="post-title">{title}</h1>

            <div class="post-meta">
                <time datetime={date.toISOString()} class="post-date">
                    {formatDate(date)}
                </time>
                {
                    readingTime && (
                        <>
                            <span class="separator">•</span>
                            <span class="reading-time">{readingTime}</span>
                        </>
                    )
                }
            </div>

            {
                tags.length > 0 && (
                    <div class="post-tags">
                        {tags.map((tag) => (
                            <span class="tag">#{tag}</span>
                        ))}
                    </div>
                )
            }
        </header>

        <!-- Post content (MDX) -->
        <div class="prose">
            <slot />
        </div>

        <!-- Post footer -->
        <footer class="post-footer">
            <a href="/posts" class="back-link-footer"> ← cd ../posts </a>
        </footer>
    </article>
</BaseLayout>

<style>
    .post {
        padding: 8rem 0 4rem;
    }

    .back-link {
        display: inline-block;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        margin-bottom: 2rem;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--color-text-primary);
    }

    .post-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-ocean-border-subtle);
    }

    .post-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 400;
        color: var(--color-text-primary);
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        margin-bottom: 1rem;
    }

    .post-date {
        color: var(--color-text-muted);
    }

    .separator {
        color: var(--color-text-muted);
    }

    .reading-time {
        color: var(--color-text-muted);
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        font-size: 0.75rem;
        color: var(--color-accent-green);
        background-color: var(--color-ocean-surface);
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        border: 1px solid var(--color-ocean-border);
    }

    .post-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-ocean-border-subtle);
    }

    .back-link-footer {
        display: inline-block;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .back-link-footer:hover {
        color: var(--color-text-primary);
    }

    /* Prose styling for MDX content */
    .prose {
        font-size: 1rem;
        line-height: 1.75;
        color: var(--color-text-primary);
    }

    .prose :global(h2) {
        font-size: 1.75rem;
        font-weight: 400;
        color: var(--color-text-primary);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
    }

    .prose :global(h3) {
        font-size: 1.375rem;
        font-weight: 400;
        color: var(--color-text-primary);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.4;
    }

    .prose :global(h4) {
        font-size: 1.125rem;
        font-weight: 400;
        color: var(--color-text-primary);
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .prose :global(p) {
        margin-bottom: 1.5rem;
        font-weight: 300;
    }

    .prose :global(a) {
        color: var(--color-accent-blue);
        text-decoration: underline;
        transition: color 0.2s ease;
    }

    .prose :global(a:hover) {
        color: var(--color-accent-blue-hover);
    }

    .prose :global(strong) {
        font-weight: 500;
        color: var(--color-text-primary);
    }

    .prose :global(em) {
        font-style: italic;
        color: var(--color-text-secondary);
    }

    .prose :global(code) {
        font-family: inherit;
        font-size: 0.875em;
        color: var(--color-accent-green);
        background-color: var(--color-ocean-surface);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        border: 1px solid var(--color-ocean-border);
    }

    .prose :global(pre) {
        background-color: var(--color-ocean-surface);
        border: 1px solid var(--color-ocean-border);
        border-radius: 6px;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.5rem 0;
    }

    .prose :global(pre code) {
        background-color: transparent;
        padding: 0;
        border: none;
        color: var(--color-text-primary);
    }

    .prose :global(blockquote) {
        border-left: 3px solid var(--color-accent-blue);
        padding-left: 1.25rem;
        margin: 1.5rem 0;
        color: var(--color-text-secondary);
        font-style: italic;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
    }

    .prose :global(li) {
        margin-bottom: 0.5rem;
        font-weight: 300;
    }

    .prose :global(li::marker) {
        color: var(--color-accent-blue);
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--color-ocean-border);
        margin: 2.5rem 0;
    }

    .prose :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
        margin: 1.5rem 0;
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 0.75rem;
        border: 1px solid var(--color-ocean-border);
        text-align: left;
    }

    .prose :global(th) {
        background-color: var(--color-ocean-surface);
        font-weight: 500;
        color: var(--color-text-primary);
    }

    .prose :global(td) {
        font-weight: 300;
    }

    @media (max-width: 768px) {
        .post {
            padding: 6rem 0 3rem;
        }

        .post-title {
            font-size: 2rem;
        }

        .prose :global(h2) {
            font-size: 1.5rem;
        }

        .prose :global(h3) {
            font-size: 1.25rem;
        }

        .prose :global(pre) {
            padding: 1rem;
            margin: 1rem -1.5rem;
            border-radius: 0;
        }
    }
</style>
