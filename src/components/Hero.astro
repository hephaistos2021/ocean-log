---
// Hero section component
import BlinkingCursor from './BlinkingCursor.astro';
---

<section class="hero" aria-label="메인 히어로 섹션">
  <div class="hero-content">
    <p class="comment fade-in-up" style="animation-delay: 0.1s;" aria-hidden="true">
      // a developer's journey
    </p>

    <h1 class="hero-title fade-in-up" style="animation-delay: 0.2s;">
      <span class="ocean">ocean</span><span class="dash">-</span><span class="log">log</span><span aria-hidden="true"><BlinkingCursor /></span>
    </h1>

    <p class="subtitle fade-in-up" style="animation-delay: 0.3s;">
      개발자의 깊은 바다 항해 일지
    </p>

    <a href="/posts" class="cta-button fade-in-up" style="animation-delay: 0.4s;" aria-label="블로그 포스트 보기">
      $ cd ./posts
    </a>

    <div class="scroll-indicator fade-in-up" style="animation-delay: 0.5s;" aria-hidden="true">
      ↓ scroll
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 10;
    padding: 2rem 2.5rem;
  }

  .hero-content {
    max-width: 700px;
    width: 100%;
    text-align: center;
  }

  .comment {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .ocean {
    color: var(--color-accent-blue);
  }

  .dash {
    color: var(--color-text-muted);
  }

  .log {
    color: var(--color-text-primary);
  }

  .subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-accent-green-dark);
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  .cta-button:hover {
    background-color: var(--color-accent-green-alt);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    animation: bounce 2s infinite;
  }

  .fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-10px);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 1.5rem;
    }

    .subtitle {
      font-size: 0.875rem;
    }
  }
</style>
