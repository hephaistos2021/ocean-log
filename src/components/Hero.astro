---
// Hero section component
import BlinkingCursor from "./BlinkingCursor.astro";
---

<section class="hero" aria-label="메인 히어로 섹션">
    <div class="hero-content">
        <p
            class="comment slide-in-up"
            style="animation-delay: 0.1s;"
            aria-hidden="true"
        >
            // a developer's journey
        </p>

        <h1 class="hero-title slide-in-up" style="animation-delay: 0.2s;">
            <span class="ocean">ocean</span><span class="dash">-</span><span
                class="log">log</span
            ><span aria-hidden="true"><BlinkingCursor /></span>
        </h1>

        <p class="subtitle slide-in-up" style="animation-delay: 0.3s;">
            개발자의 깊은 바다 항해 일지
        </p>

        <a
            href="/posts"
            class="cta-button slide-in-up"
            style="animation-delay: 0.4s;"
            aria-label="블로그 포스트 보기"
        >
            $ cd ./posts
        </a>
    </div>

    <div
        class="scroll-indicator"
        aria-hidden="true"
    >
        ↓ scroll
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 10;
        padding: 2rem 2.5rem;
    }

    .hero-content {
        max-width: 700px;
        width: 100%;
        text-align: center;
    }

    .comment {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
    }

    .hero-title {
        font-size: clamp(2.5rem, 8vw, 5rem);
        font-weight: 400;
        line-height: 1.1;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }

    .ocean {
        color: var(--color-accent-blue);
    }

    .dash {
        color: var(--color-text-muted);
    }

    .log {
        color: var(--color-text-primary);
    }

    .subtitle {
        font-size: 1rem;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
        font-weight: 300;
    }

    .cta-button {
        display: inline-block;
        background-color: var(--color-accent-green-dark);
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: background-color 0.2s ease;
    }

    .cta-button:hover {
        background-color: var(--color-accent-green-alt);
    }

    .scroll-indicator {
        position: absolute;
        bottom: 3rem;
        left: 50%;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        text-align: center;
        transform: translateX(-50%) translateY(20px);
        visibility: hidden;
        animation: slideInUpCentered 0.8s ease 0.5s forwards, bounce 2s infinite 1.3s;
    }


    .slide-in-up {
        visibility: hidden;
        animation: slideInUp 0.6s ease forwards;
    }

    @keyframes slideInUp {
        from {
            transform: translateY(20px);
            visibility: hidden;
        }
        to {
            transform: translateY(0);
            visibility: visible;
        }
    }

    @keyframes slideInUpCentered {
        from {
            transform: translateX(-50%) translateY(20px);
            visibility: hidden;
        }
        to {
            transform: translateX(-50%) translateY(0);
            visibility: visible;
        }
    }

    @keyframes bounce {
        0%,
        100% {
            transform: translateX(-50%) translateY(0);
        }
        50% {
            transform: translateX(-50%) translateY(-10px);
        }
    }

    @media (max-width: 768px) {
        .hero {
            padding: 2rem 1.5rem;
        }

        .subtitle {
            font-size: 0.875rem;
        }
    }
</style>
