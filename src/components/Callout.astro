---
interface Props {
	type?: "info" | "warning" | "error" | "success";
	title?: string;
}

const { type = "info", title } = Astro.props;

const typeStyles = {
	info: {
		border: "border-accent-blue",
		bg: "bg-ocean-border-subtle",
		icon: "ℹ",
		titleColor: "text-accent-blue",
	},
	warning: {
		border: "border-yellow-400",
		bg: "bg-ocean-border-subtle",
		icon: "⚠",
		titleColor: "text-yellow-400",
	},
	error: {
		border: "border-red-400",
		bg: "bg-ocean-border-subtle",
		icon: "✕",
		titleColor: "text-red-400",
	},
	success: {
		border: "border-accent-green",
		bg: "bg-ocean-border-subtle",
		icon: "✓",
		titleColor: "text-accent-green",
	},
};

const style = typeStyles[type];
---

<div
    class={`my-6 border-l-4 ${style.border} ${style.bg} p-4 rounded-r-lg font-mono`}
>
    {
        title && (
            <div
                class={`flex items-center gap-2 mb-2 font-bold ${style.titleColor}`}
            >
                <span class="text-lg">{style.icon}</span>
                <span>{title}</span>
            </div>
        )
    }
    <div class="text-text-secondary leading-relaxed">
        <slot />
    </div>
</div>
