---
// SVG wave animation for atmospheric background
---

<div class="wave-background" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none" role="presentation">
    <defs>
      <linearGradient id="wave-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" style="stop-color:#58a6ff;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#39d353;stop-opacity:1" />
      </linearGradient>
    </defs>
    <path
      class="wave wave-1"
      fill="url(#wave-gradient)"
      d="M0,160L48,144C96,128,192,96,288,106.7C384,117,480,171,576,181.3C672,192,768,160,864,144C960,128,1056,128,1152,133.3C1248,139,1344,149,1392,154.7L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
    />
    <path
      class="wave wave-2"
      fill="url(#wave-gradient)"
      d="M0,224L48,213.3C96,203,192,181,288,181.3C384,181,480,203,576,197.3C672,192,768,160,864,154.7C960,149,1056,171,1152,165.3C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
    />
  </svg>
</div>

<style>
  .wave-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  svg {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 100%;
    opacity: 0.06;
  }

  .wave-1 {
    animation: wave-animation-1 20s ease-in-out infinite;
  }

  .wave-2 {
    animation: wave-animation-2 25s ease-in-out infinite;
  }

  @keyframes wave-animation-1 {
    0%, 100% {
      transform: translateX(0) translateY(0);
    }
    50% {
      transform: translateX(-25px) translateY(-15px);
    }
  }

  @keyframes wave-animation-2 {
    0%, 100% {
      transform: translateX(0) translateY(0);
    }
    50% {
      transform: translateX(25px) translateY(-10px);
    }
  }
</style>
